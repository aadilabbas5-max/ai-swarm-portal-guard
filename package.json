{
    "name": "swarm-anti-hallucination-portal",
    "displayName": "AI Swarm Portal Guard",
    "description": "A local pre-flight check that flags common secrets, shell abuse, and obvious code breakage.",
    "version": "0.1.0",
    "publisher": "aadil-swarm-labs",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/aadilabbas5-max/ai-swarm-portal-guard.git"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Linters",
        "Programming Languages",
        "Security"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./extension.js",
    "contributes": {
        "configuration": {
            "title": "AI Swarm Portal Configurations",
            "properties": {
                "swarmPlatform.serverHost": {
                    "type": "string",
                    "default": "127.0.0.1",
                    "description": "The destination address hosting your local telemetry server."
                },
                "swarmPlatform.serverPort": {
                    "type": "integer",
                    "default": 5000,
                    "description": "Port of the local Swarm Guard server (default 5000)."
                }
            }
        },
        "commands": [
            {
                "command": "swarmPlatform.scanCredentials",
                "title": "Swarm: Scan Credentials"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "command": "swarmPlatform.scanCredentials",
                    "group": "modification@1",
                    "when": "editorHasSelection"
                }
            ]
        }
    },
    "devDependencies": {
        "@types/vscode": "^1.75.0"
    }
}